{
  "name": "CriteriaList",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da lista de crit\u00e9rios (ex: Banco de Dados)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da lista / disciplina"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do professor que criou a lista"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        }
      },
      "description": "Crit\u00e9rios dentro desta lista"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}