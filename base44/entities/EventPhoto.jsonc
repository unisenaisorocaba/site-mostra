{
  "name": "EventPhoto",
  "type": "object",
  "properties": {
    "photo_url": {
      "type": "string",
      "description": "URL da foto"
    },
    "caption": {
      "type": "string",
      "description": "Legenda da foto"
    },
    "category": {
      "type": "string",
      "enum": [
        "abertura",
        "apresentacoes",
        "premiacao",
        "encerramento",
        "geral"
      ],
      "default": "geral",
      "description": "Categoria da foto"
    }
  },
  "required": [
    "photo_url"
  ]
}