{
  "name": "Group",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do grupo"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do aluno que criou o grupo"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          }
        }
      },
      "description": "Membros do grupo com status de convite"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do grupo"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}