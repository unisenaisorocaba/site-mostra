{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do projeto"
    },
    "category": {
      "type": "string",
      "enum": [
        "mecatronica",
        "software",
        "gestao",
        "logistica",
        "energia",
        "quimica",
        "automacao",
        "outros"
      ],
      "description": "Categoria do projeto"
    },
    "team_name": {
      "type": "string",
      "description": "Nome do grupo/equipe"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ra": {
            "type": "string"
          }
        }
      },
      "description": "Membros da equipe"
    },
    "advisor": {
      "type": "string",
      "description": "Nome do orientador"
    },
    "room": {
      "type": "string",
      "description": "Sala/local de apresenta\u00e7\u00e3o"
    },
    "banner_url": {
      "type": "string",
      "description": "URL do banner do projeto"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da imagem thumbnail"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "submetido",
        "aprovado",
        "reprovado"
      ],
      "default": "rascunho",
      "description": "Status da submiss\u00e3o"
    },
    "abstract": {
      "type": "string",
      "description": "Resumo do projeto"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palavras-chave"
    }
  },
  "required": [
    "title",
    "category",
    "team_name"
  ]
}