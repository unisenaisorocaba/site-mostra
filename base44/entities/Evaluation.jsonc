{
  "name": "Evaluation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto avaliado"
    },
    "evaluator_name": {
      "type": "string",
      "description": "Nome do avaliador"
    },
    "criteria_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criteria_id": {
            "type": "string"
          },
          "criteria_name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "description": "Lista de notas por crit\u00e9rio (professores)"
    },
    "criteria_innovation": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Nota para inova\u00e7\u00e3o (alunos - banner)"
    },
    "criteria_technical": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Nota para qualidade t\u00e9cnica (alunos - banner)"
    },
    "criteria_presentation": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Nota para apresenta\u00e7\u00e3o (alunos - banner)"
    },
    "criteria_relevance": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Nota para relev\u00e2ncia (alunos - banner)"
    },
    "comments": {
      "type": "string",
      "description": "Coment\u00e1rios do avaliador"
    },
    "evaluation_type": {
      "type": "string",
      "enum": [
        "professor",
        "aluno"
      ],
      "default": "professor",
      "description": "Tipo de avaliador"
    }
  },
  "required": [
    "project_id"
  ]
}