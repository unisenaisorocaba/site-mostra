{
  "name": "EvaluationCriteria",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do crit\u00e9rio"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o / instru\u00e7\u00e3o de avalia\u00e7\u00e3o"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do professor que criou o crit\u00e9rio"
    },
    "weight": {
      "type": "number",
      "default": 1,
      "description": "Peso do crit\u00e9rio na nota final"
    }
  },
  "required": [
    "name",
    "owner_email"
  ]
}